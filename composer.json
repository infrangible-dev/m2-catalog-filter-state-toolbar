{
    "name": "infrangible/m2-catalog-filter-state-toolbar",
    "description": "Shows the currently applied filters directly above the product list, each with a remove link, plus a \"Clear All\" link, instead of in the sidebar.",
    "type": "magento2-module",
    "version": "2.0.0",
    "license": "MIT",
    "keywords": [
        "Magento",
        "Magento 2",
        "Adobe Commerce",
        "Layered navigation",
        "Catalog",
        "Hyvä",
        "active filters above the product list",
        "applied filters toolbar",
        "clear all filters link"
    ],
    "homepage": "https://www.infrangible.dev/modules/catalog-filter-state-toolbar",
    "authors": [
        {
            "name": "Andreas Knollmann",
            "email": "a.knollmann@seak.dev",
            "homepage": "https://www.seak.dev",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.1",
        "fewedev/base": "~2.4.3",
        "infrangible/m2-core": "~5.0.6",
        "infrangible/m2-foundation": "~3.0.1",
        "magento/framework": "~103.0.6",
        "magento/module-catalog": "~104.0.0"
    },
    "autoload": {
        "files": [
            "src/registration.php"
        ],
        "psr-4": {
            "Infrangible\\CatalogFilterStateToolbar\\": "src"
        }
    },
    "require-dev": {
        "infrangible/phpstan-magento": "~1.2.0"
    }
}
