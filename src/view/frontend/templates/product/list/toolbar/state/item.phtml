use Infrangible\CatalogFilterStateToolbar\Block\Product\ProductList\Toolbar\State\Item;
use Magento\Framework\Escaper;

/** @var Escaper $escaper */
/** @var Item $block */

$labelClass = $escaper->escapeHtmlAttr($block->getDataString('labelClass'));
$valueClass = $escaper->escapeHtmlAttr($block->getDataString('valueClass'));
?>

<li class="<?= $escaper->escapeHtmlAttr($block->getDataString('itemClass')) ?>">
    <a class="<?= $escaper->escapeHtmlAttr($block->getDataString('linkClass')) ?>"
       href="<?= $escaper->escapeUrl($block->getRemoveUrl()) ?>"
       title="<?= $escaper->escapeHtmlAttr($block->getRemoveTitle()) ?>">
        <span class="<?= /* @noEscape */ $labelClass ?>"><?= $escaper->escapeHtml($block->getFilterName()) ?></span>
        <span class="<?= /* @noEscape */ $valueClass ?>"><?= $escaper->escapeHtml($block->getFilterValue()) ?></span>
    </a>
    <?= /* @noEscape */ $block->renderAdditional() ?>
</li>
