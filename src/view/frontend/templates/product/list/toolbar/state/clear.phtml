       title="<?= $escaper->escapeHtmlAttr(__('Clear All')) ?>">
        <span class="<?= /* @noEscape */ $valueClass ?>"><?= $escaper->escapeHtml(__('Clear All')) ?></span>
    </a>
    <?= $block->getChildHtml('additional') ?>
