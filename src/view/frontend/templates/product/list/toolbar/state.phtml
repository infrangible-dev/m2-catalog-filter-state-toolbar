use Infrangible\CatalogFilterStateToolbar\Block\Product\ProductList\Toolbar\State;
use Magento\Framework\Escaper;

/** @var Escaper $escaper */
/** @var State $block */

$filters = $block->getActiveFilters();
?>

<?php if (count($filters) > 0): ?>
    <div class="<?= $escaper->escapeHtmlAttr($block->getDataString('toolbarClass')) ?>">
        <div class="<?= $escaper->escapeHtmlAttr($block->getDataString('filtersClass')) ?>">
            <ol class="<?= $escaper->escapeHtmlAttr($block->getDataString('itemsClass')) ?>">
                <?php foreach ($filters as $filter): ?>
                    <?= /* @noEscape */ $block->renderFilter($filter) ?>
                <?php endforeach; ?>
                <?= /* @noEscape */ $block->renderClear() ?>
            </ol>
        </div>
    </div>
<?php endif; ?>
