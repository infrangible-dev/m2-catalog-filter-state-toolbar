<?php

declare(strict_types=1);

use Infrangible\CatalogFilterStateToolbar\Block\Product\ProductList\Toolbar\State;
use Magento\Framework\Escaper;
use Magento\Framework\View\TemplateEngine\Php;

/**
 * @author      Andreas Knollmann
 * @copyright   2014-2025 Softwareentwicklung Andreas Knollmann
 * @license     http://www.opensource.org/licenses/mit-license.php MIT
 */

/** @var Php $this */
/** @var Escaper $escaper */
/** @var State $block */

$filters = $block->getActiveFilters();
?>

<?php if (count($filters) > 0): ?>
    <div class="<?= $block->getData('toolbarClass'); ?>">
        <div class="<?= $block->getData('filtersClass'); ?>">
            <ol class="<?= $block->getData('itemsClass'); ?>">
                <?php foreach ($filters as $filter): ?>
                    <?= $block->renderFilter($filter); ?>
                <?php endforeach; ?>
                <?= $block->renderClear(); ?>
            </ol>
        </div>
    </div>
<?php endif; ?>
